# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Example binaries: go build names them after their directory, and example sources all carry an extension
examples/*/*
!examples/*/*.*
!examples/*/*/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.txt
coverage.html

# Dependency directories
vendor/

# Go workspace file
go.work
go.work.sum

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

tmp/*